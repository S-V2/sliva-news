# Keep the build context small and deterministic. node_modules is deliberately
# excluded: the dependencies stage installs from package-lock.json inside the
# image, so a host node_modules (macOS/darwin sharp binaries, for one) must never
# leak in and shadow the musl build.
node_modules
.next
out
dist
.git
.gitignore
.github
.env
.env.*
!.env.example
npm-debug.log*
*.tsbuildinfo
.DS_Store
Dockerfile
.dockerignore
README.md
